# No trailing slash, so it also matches a `build` symlink; `build/` matches directories only.
/build

# Every other build directory, at any depth, such as tst/build or a builds/ tree.
**/build*/

# macOS Finder metadata.
.DS_Store

# Python: bytecode, test caches, and the sdist and wheels python -m build writes. build_python/, where pip builds
# the module, matches the build-directory rule above.
__pycache__/
.pytest_cache/
/dist/
*.egg-info/
